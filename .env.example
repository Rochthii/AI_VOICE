# ==============================================================================
# CHI VOICE — SUBTERRANEAN AI TOUR GUIDE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Google Gemini API (Miễn phí / Trả lời sử liệu chính xác)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_backup_gemini_api_key_here

# 2. Groq Cloud API (Miễn phí / Whisper STT Nhận diện giọng nói siêu tốc <300ms)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_backup_groq_api_key_here

# 3. OpenRouter API (Tùy chọn / Fallback dự phòng)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Supabase Telemetry & Offline Sync (Tùy chọn)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 5. App Domain URL (Tự động trên Vercel)
NEXT_PUBLIC_APP_URL=https://ai-voice.vercel.app
